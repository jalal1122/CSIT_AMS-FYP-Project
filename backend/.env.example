# Server
PORT=5001
NODE_ENV=development
BODY_SIZE_LIMIT=10mb

# Database
MONGODB_URI=mongodb://localhost:27017/csit_ams_v2

# JWT
JWT_ACCESS_SECRET=v2_access_secret_change_in_prod
JWT_REFRESH_SECRET=v2_refresh_secret_change_in_prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
QR_SECRET=v2_qr_secret_change_in_prod

# Security
ADMIN_SECRET=your_admin_bootstrap_secret
DEFAULT_STUDENT_PASSWORD=password123

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Pusher
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=ap2

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@csit-ams.edu

# Client
CLIENT_URL=http://localhost:5173

# Cron Security (used by the /api/v2/cron/* endpoint)
# In production: cPanel cron hits this endpoint with this secret
# In local dev: node-cron runs on the schedule below directly
CRON_SECRET=change_this_to_a_long_random_secret

# Cron Schedule (configurable for easy local testing)
# Format: hour (0-23) and weekday (0=Sunday, 5=Friday)
# Default: Friday at 17:00 (5 PM) Pakistan time
# For local testing, change to a few minutes from now: CRON_ALERT_HOUR=14, CRON_ALERT_DAY=2 (Tuesday)
CRON_ALERT_HOUR=17
CRON_ALERT_DAY=5
CRON_TIMEZONE=Asia/Karachi
